# Replace placeholders before importing into the cf_vm Portainer stack.
# Timezone example; choose your local IANA timezone.
TZ=<TIMEZONE>
# Absolute directory on cf_vm for local configuration, export and consume folders.
VM_CONFIG_ROOT=/home/<VM_USER>

# Nextcloud: use the application account created in TrueNAS MariaDB.
NEXTCLOUD_PORT=<NEXTCLOUD_PORT>
MYSQL_HOST=<TRUENAS_IP>:<PUBLISHED_MARIADB_PORT>
MYSQL_DATABASE=<NEXTCLOUD_DB_NAME>
MYSQL_USER=<NEXTCLOUD_DB_USER>
MYSQL_PASS=<NEXTCLOUD_DB_PASSWORD>

# Open Web UI: these IDs are passed as PUID/PGID; runtime effect needs verification.
OPENWEBUI_PORT=<OPENWEBUI_PORT>
OPENWEBUI_UID=<OPENWEBUI_UID>
OPENWEBUI_GID=<OPENWEBUI_GID>

# Paperless: same TrueNAS MariaDB server, but a different database name and user.
# Storage account IDs are separate from database credentials.
PAPERLESS_PORT=<PAPERLESS_PORT>
PAPERLESS_URL=https://paperless.<YOUR_DOMAIN>
PAPERLESS_UID=<PAPERLESS_UID>
PAPERLESS_GID=<PAPERLESS_GID>
DB_HOST=<TRUENAS_IP>
DB_PORT=<PUBLISHED_MARIADB_PORT>
DB_USER=<PAPERLESS_DB_USER>
DB_PASS=<PAPERLESS_DB_PASSWORD>
DB_NAME=<PAPERLESS_DB_NAME>

# SearXNG: published through Gluetun; hostname has no scheme or trailing slash.
GLUETUN_PORT=<SEARXNG_PUBLISHED_PORT>
SEARXNG_HOSTNAME=searxng.<YOUR_DOMAIN>
SEARXNG_UWSGI_WORKERS=4
SEARXNG_UWSGI_THREADS=4

# Gluetun uses OpenVPN in this Compose file. Use provider service credentials.
VPN_SERVICE_PROVIDER=<VPN_SERVICE_PROVIDER>
OPENVPN_USER=<OPENVPN_USER>
OPENVPN_PASSWORD=<OPENVPN_PASSWORD>
VPN_COUNTRY=<VPN_COUNTRY>
VPN_CITY=<VPN_CITY>

# Watchtower notification URL may contain credentials; keep it private.
WT_NOTIF_URL=<SHOUTRRR_NOTIFICATION_URL>
